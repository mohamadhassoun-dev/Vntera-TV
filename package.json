{
  "name": "vntera-iptv",
  "private": true,
  "version": "1.1.12",
  "type": "module",
  "description": "Vntera TV — IPTV streaming for web, Android, Android TV and Windows",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "serve": "node server.js",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "apk": "node scripts/build-apk.mjs",
    "qr": "node scripts/make-qr.mjs",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "node scripts/build-desktop.mjs --dev",
    "desktop:smoke": "node scripts/build-desktop.mjs --dev --smoke",
    "desktop:build": "node scripts/build-desktop.mjs",
    "tv": "node scripts/build-apk.mjs --target tv",
    "apk:all": "node scripts/build-apk.mjs --target both",
    "artifacts": "node scripts/publish-artifacts.mjs",
    "deploy": "node scripts/deploy-site.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "hls.js": "^1.6.5",
    "mpegts.js": "^1.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "author": {
    "name": "Vntera Media Networks"
  }
}
