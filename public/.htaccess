# Vntera on shared hosting (Hostinger / LiteSpeed / Apache).
# Built by Vite into dist/ together with index.html.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Same-origin panel bridge: /xtream/<path> -> xtream-proxy.php (streams to the panel).
  RewriteRule ^xtream/(.*)$ xtream-proxy.php?__p=$1 [QSA,L]
  RewriteRule ^xtream$ xtream-proxy.php [QSA,L]

  # Deploy check: reports the panel origin this site resolved.
  RewriteRule ^healthz$ xtream-proxy.php?__health=1 [QSA,L]

  # Serve real files (assets, logos, icons) as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a SPA route.
  RewriteRule . /index.html [L]
</IfModule>

# Android packages are versioned by file name, so serve them as downloads.
AddType application/vnd.android.package-archive .apk

<IfModule mod_headers.c>
  # Hashed build output never changes; keep HTML fresh.
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|mp4|apk)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
